---
import { Image, Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import type { ImageFormat, ResponsiveImageLayout } from "@/types/config";
import {
	getFallbackFormat,
	getImageFormats,
	getImageQuality,
	shouldAddNoReferrer,
} from "@/utils/image-utils";
import { getLqipProps } from "@/utils/lqip-utils";
import { getRemoteImage } from "@/utils/remote-image";
import { url } from "@/utils/url-utils";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "lazy" | "eager";
	fetchpriority?: "high" | "low" | "auto";
	// 响应式图像属性
	layout?: ResponsiveImageLayout;
	usePicture?: boolean;
	formats?: ImageFormat[];
	widths?: number[];
	sizes?: string;
	quality?: number;
	deferred?: boolean;
}

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	fetchpriority = "auto",
	layout = "constrained",
	usePicture = true,
	formats = getImageFormats(),
	widths,
	sizes,
	quality = getImageQuality(),
	deferred = false,
} = Astro.props;

const fallbackFormat = getFallbackFormat();
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img: ImageMetadata | null = null;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif}",
		{
			import: "default",
		},
	);
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const imageClass =
	"w-full h-full object-cover opacity-0 transition-opacity duration-500 ease-out";
const imageStyle = `object-position: ${position}`;

// 检查是否需要添加 referrerpolicy（仅对非本地图片）
const fullSrc = isPublic ? url(src) : src;
const referrerPolicy =
	!isLocal && shouldAddNoReferrer(fullSrc) ? "no-referrer" : undefined;
const remoteImage =
	!isLocal && !isPublic && widths
		? await getRemoteImage(src, widths, quality)
		: { src: fullSrc, srcset: undefined, width: undefined, height: undefined };
const ImageContainer = deferred ? "template" : "div";

// 构建响应式图像属性
const responsiveProps = {
	...(layout && { layout }),
	...(widths && { widths }),
	...(sizes && { sizes }),
	...(quality && { quality }),
};

// LQIP 渐变占位
const lqipProps = isLocal
	? getLqipProps(src, basePath)
	: isPublic
		? getLqipProps(src, basePath, true)
		: getLqipProps(src);
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>
    <div class="transition absolute inset-0 dark:bg-black/10 pointer-events-none"></div>
    <ImageContainer data-deferred-image={deferred || undefined} style={deferred ? undefined : "display:contents"}>
    {isLocal && img && usePicture && (
        <Picture
            src={img}
            alt={alt || ""}
            class={imageClass}
            style={imageStyle}
            loading={loading}
            fetchpriority={fetchpriority}
            formats={formats}
            fallbackFormat={fallbackFormat}
            {...responsiveProps}
        />
    )}
    {isLocal && img && !usePicture && (
        <Image
            src={img}
            alt={alt || ""}
            class={imageClass}
            style={imageStyle}
            loading={loading}
            fetchpriority={fetchpriority}
            {...responsiveProps}
        />
    )}
    {!isLocal && <img src={remoteImage.src} srcset={remoteImage.srcset} sizes={remoteImage.srcset ? sizes : undefined} width={remoteImage.width} height={remoteImage.height} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} decoding="async" fetchpriority={fetchpriority} referrerpolicy={referrerPolicy} />}
    </ImageContainer>
</div>
