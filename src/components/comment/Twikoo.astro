---
import bundledScriptUrl from "twikoo?url";
import { commentConfig } from "@/config/commentConfig";
import { url } from "@/utils/url-utils";

interface Props {
	path: string;
}

const { jsUrl, cssUrl, ...options } = commentConfig.twikoo ?? { envId: "" };
// 使用配置的页面标识，而不是地址栏，确保预览域名和尾斜杠不分裂评论。
const path = Astro.props.path.replace(/\/+$/, "") || "/";
const scriptUrl = jsUrl ? (jsUrl.startsWith("http") ? jsUrl : url(jsUrl)) : bundledScriptUrl;
const config = {
	...options,
	path,
	href: new URL(path, Astro.site).href,
};
---

<div id="tcomment" data-config={JSON.stringify(config)} data-script-url={scriptUrl}>
  <p role="status" class="text-50 py-4">评论加载中…</p>
</div>
{cssUrl && <link rel="stylesheet" href={cssUrl.startsWith("http") ? cssUrl : url(cssUrl)} />}

<script>
  interface TwikooClient {
    init: (options: Record<string, unknown>) => Promise<void>;
  }

  interface TwikooState {
    clientPromise?: Promise<TwikooClient>;
    initialized: WeakSet<HTMLElement>;
    swupBound: boolean;
    styles: HTMLStyleElement[];
    init?: () => Promise<void>;
  }

  declare global {
    interface Window {
      twikoo?: TwikooClient;
      __fireflyTwikoo?: TwikooState;
    }
  }

  // Swup 会重跑内联模块，状态保存在 window 上，避免每次导航叠加监听器。
  const state = window.__fireflyTwikoo ??= {
    initialized: new WeakSet<HTMLElement>(),
    swupBound: false,
    styles: [],
  } as TwikooState;

  function loadClient(src: string): Promise<TwikooClient> {
    if (window.twikoo) return Promise.resolve(window.twikoo);
    if (state.clientPromise) return state.clientPromise;

    state.clientPromise = new Promise<TwikooClient>((resolve, reject) => {
      const script = document.createElement("script");
      script.src = src;
      script.async = true;
      const fail = () => {
        clearTimeout(timer);
        script.remove();
        state.clientPromise = undefined;
        reject(new Error("Twikoo 脚本加载失败"));
      };
      const timer = window.setTimeout(fail, 20000);
      script.onload = () => {
        clearTimeout(timer);
        if (!window.twikoo) return fail();
        state.styles = [...document.querySelectorAll<HTMLStyleElement>("style[data-twikoo]")];
        resolve(window.twikoo);
      };
      script.onerror = fail;
      document.head.append(script);
    });
    return state.clientPromise;
  }

  async function initTwikoo(): Promise<void> {
    const container = document.getElementById("tcomment");
    if (!container || state.initialized.has(container)) return;
    state.initialized.add(container);

    try {
      const options = JSON.parse(container.dataset.config || "{}");
      const client = await loadClient(container.dataset.scriptUrl || "");
      // 用户已切到别的页面时，不再挂载过期页面的评论。
      if (!container.isConnected || document.getElementById("tcomment") !== container) return;
      // Head 插件会移除 SDK 动态注入的样式；复用已加载样式，无需重下脚本。
      for (const style of state.styles) {
        if (!style.isConnected) document.head.append(style);
      }
      container.replaceChildren();
      await client.init({ ...options, el: "#tcomment" });
    } catch (error) {
      state.initialized.delete(container);
      if (!container.isConnected) return;
      console.error("[Twikoo] 初始化失败", error);
      const message = document.createElement("p");
      message.role = "alert";
      message.textContent = "评论暂时无法加载，请稍后重试。";
      const retry = document.createElement("button");
      retry.type = "button";
      retry.className = "btn-regular rounded-lg px-4 py-2 mt-2";
      retry.textContent = "重新加载评论";
      retry.addEventListener("click", () => void initTwikoo(), { once: true });
      container.replaceChildren(message, retry);
    }
  }

  function bindSwup(): void {
    if (state.swupBound || !window.swup?.hooks) return;
    state.swupBound = true;
    window.swup.hooks.on("page:view", initTwikoo);
  }

  if (!state.init) {
    state.init = initTwikoo;
    bindSwup();
    document.addEventListener("swup:enable", bindSwup, { once: true });
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTwikoo, { once: true });
    } else {
      void initTwikoo();
    }
  } else {
    void state.init();
  }
</script>

<style is:global>
  #tcomment {
    color: var(--btn-content);
    min-height: 15rem;
  }

  #tcomment .tk-input__inner,
  #tcomment .tk-textarea__inner,
  #tcomment .tk-button {
    border-radius: 0.65rem;
  }

  #tcomment .tk-input__inner:focus,
  #tcomment .tk-textarea__inner:focus {
    border-color: var(--primary);
  }

  #tcomment .tk-button--primary:not(.is-disabled) {
    background: var(--primary);
    border-color: var(--primary);
  }

  #tcomment .tk-button--primary:not(.is-disabled):hover {
    filter: brightness(1.08);
  }

  #tcomment .tk-nick-link,
  #tcomment .tk-action-link {
    color: var(--primary);
  }
</style>
